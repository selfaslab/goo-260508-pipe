SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role: Settings → API → "service_role" (secret). Python 클라이언트는 보통 JWT(eyJ…) 형식이어야 합니다.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

OPENAI_API_KEY=sk-...
# 이 파일은 apps/api 폴더에 두세요. uvicorn을 다른 폴더에서 실행해도 이 경로의 .env를 읽습니다.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PubMed/NCBI (권장: 이메일 필수 규약 준수, API 키는 선택)
NCBI_EMAIL=
NCBI_API_KEY=
